<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Y2Remote" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#1B5E20</item>
        <item name="colorOnPrimaryContainer">#C8E6C9</item>

        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">#004D40</item>
        <item name="colorOnSecondaryContainer">#80CBC4</item>

        <item name="colorSurface">@color/card_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">#252525</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">#444444</item>
        <item name="colorOutlineVariant">#2E2E2E</item>

        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <item name="colorError">#FFB4AB</item>
        <item name="colorOnError">#690005</item>

        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

    <style name="Theme.Y2Remote.FullScreenDialog" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>